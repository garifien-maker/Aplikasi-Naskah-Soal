{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/save-exam",
      "dest": "/api/save-exam.js"
    },
    {
      "src": "/api/get-exams",
      "dest": "/api/get-exams.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
